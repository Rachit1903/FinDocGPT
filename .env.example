# Required by SEC EDGAR when downloading filings: application name plus a contact email.
SEC_USER_AGENT=FinDocGPT your.name@example.com

# Groq (OpenAI-compatible) is the only LLM provider. Each role uses a separate model so the
# free-tier per-model token quotas are spread out, and the eval judge is a different model
# family from the generator.
GROQ_API_KEY=
GENERATOR_MODEL=openai/gpt-oss-120b
AGENT_MODEL=openai/gpt-oss-20b
JUDGE_MODEL=qwen/qwen3.8-27b

# Optional: use a Qdrant server instead of the embedded on-disk store under data/index/.
# QDRANT_URL=http://localhost:6333
